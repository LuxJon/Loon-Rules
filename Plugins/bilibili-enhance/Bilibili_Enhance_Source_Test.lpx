#!name = Bilibili 请求来源试验
#!desc = 试验留档：手机已确认请求来源改写、响应带回from=66且原生链接已简化，但仍弹半屏，应停用。会改变被处理请求的来源统计，保留两项Story优化，与其他三合一版本互斥。
#!author = Codex
#!date = 2026-10-17
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = Bilibili,界面优化
#!type = normal

# 两项 Story 修改合并为一次 JSON 处理；不匹配视频详情接口。
[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story(?:\?|$)/ && ${response.status} == 200 then response.json.jq("(.data.items[]? |= del(.scroll_guide)) | if (.data.config.live_auto_enter | type) == \"object\" then .data.config.live_auto_enter.enable = false else . end")

# 请求正文仅修改已知来源组合的两个字段；不模拟界面点击。
[Script]
request if ${url} ~= /bilibili\.app\.viewunite\.v1\.View\/View(?:\?|$)/ then script("https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/bilibili-enhance/Bilibili_Space_Source_Test.js", "phase=request") with requires_body=true, binary_body_mode=true, timeout=10, tag="SpaceSource 请求来源"
response if ${url} ~= /bilibili\.app\.viewunite\.v1\.View\/View(?:\?|$)/ then script("https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/bilibili-enhance/Bilibili_Space_Source_Test.js", "phase=response") with requires_body=true, binary_body_mode=true, timeout=10, tag="SpaceSource 原生链接"

[Mitm]
hostname = app.bilibili.com,grpc.biliapi.net
