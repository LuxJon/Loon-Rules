#!name=QQ音乐SVIP启动动画屏蔽-修复版
#!icon = https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/QQ%E9%9F%B3%E4%B9%90%E5%90%AF%E5%8A%A8%E5%8A%A8%E7%94%BB%E5%B1%8F%E8%94%BD/icon.png
#!desc=屏蔽 QQ 音乐启动时服务端下发的 SVIP/钻石 MP4 动画素材；修复写死单个 mp4 文件名导致失效的问题
#!author=local

[Rewrite]
# 旧脚本只匹配 /beta/test/78e0...mp4；新抓包里已变成 /beta/test/f083...mp4 和 /beta/videov2/f083...mp4
^https?:\/\/qkcdn6-media\.tencentmusic\.com\/beta\/(?:test|videov2)\/[0-9a-f]{32}\.mp4(?:\?.*)?$ reject-200

[MITM]
hostname = qkcdn6-media.tencentmusic.com
