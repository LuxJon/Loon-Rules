#!name = Bilibili 竖屏优化
#!icon = https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/Bilibili/icon.png
#!desc = 移除竖屏 Story 视频“上滑观看”提示，关闭直播预览倒计时自动进入；整条过滤带明确广告标记的推广视频及推广直播，保留普通视频、普通直播预览与手动进入。使用内置 JSON/JQ，无需 JS。整条过滤待手机实测。
#!author = Codex
#!date = 2026-10-19
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = Bilibili,界面优化,去广告
#!type = normal

# Story 先执行原有两项优化，再从 items 中删除带明确广告标记的视频和直播条目。
[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story(?:\?|$)/ && ${response.status} == 200 then response.json.jq("(if type == \"object\" then if .code == 0 and (.data | type) == \"object\" then (if (.data.items | type) == \"array\" then .data.items |= map(if type == \"object\" then del(.scroll_guide) else . end) else . end) | (if (.data.config | type) == \"object\" then if (.data.config.live_auto_enter | type) == \"object\" then if (.data.config.live_auto_enter | has(\"enable\")) then .data.config.live_auto_enter.enable = false else . end else . end else . end) else . end else . end) | (def is_story_ad: if type != \"object\" then false elif .goto == \"vertical_ad_av\" or .goto == \"vertical_ad_live\" or .card_goto == \"vertical_ad_av\" or .card_goto == \"vertical_ad_live\" then true elif (.ad_info | type) == \"object\" then .ad_info.is_ad == true or .ad_info.is_ad == 1 else false end; if type != \"object\" then . elif .code != 0 or (.data | type) != \"object\" then . elif (.data.items | type) != \"array\" then . else .data.items |= map(select(is_story_ad | not)) end)")

# 动态推广卡片同时覆盖 data.anchor 和 data.ads 数组，保留其他响应数据。
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\/cart(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code != 0 or (.data | type) != \"object\" then . else .data |= ( del(.anchor) | if (.ads | type) == \"array\" then .ads = [] else . end ) end")

[Mitm]
hostname = app.bilibili.com
