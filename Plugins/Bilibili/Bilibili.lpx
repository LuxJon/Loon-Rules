#!name = Bilibili 竖屏优化
#!icon = https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/Bilibili/icon.png
#!desc = 移除竖屏 Story 视频“上滑观看”提示，关闭直播预览倒计时自动进入，保留直播预览及手动进入。使用 JSON 复写，无需 JS 脚本。仅处理竖屏 Story 接口。
#!author = Codex
#!date = 2026-10-18
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = Bilibili,界面优化
#!type = normal

# 两项优化合并处理，仅修改成功响应中已有的目标字段。
[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type == \"object\" then if .code == 0 and (.data | type) == \"object\" then (if (.data.items | type) == \"array\" then .data.items |= map(if type == \"object\" then del(.scroll_guide) else . end) else . end) | (if (.data.config | type) == \"object\" then if (.data.config.live_auto_enter | type) == \"object\" then if (.data.config.live_auto_enter | has(\"enable\")) then .data.config.live_auto_enter.enable = false else . end else . end else . end) else . end else . end")

[Mitm]
hostname = app.bilibili.com
