#!name = Bilibili 竖屏优化
#!icon = https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/Bilibili/icon.png
#!homepage = https://github.com/LuxJon/Loon-Rules/tree/main/Plugins/Bilibili
#!desc = 自用补充插件：过滤首页广告与直播卡片、整条竖屏推广视频及推广直播，清理推广浮层和上滑提示，关闭直播自动进入。保留原 Biliverse ADBlock 订阅及更新链接。本插件开启的接口由本插件接管，原脚本在相同接口不执行；不继承其补位及自定义设置。可关闭对应接管开关恢复原脚本。待手机实测。
#!author = LuxJon,Codex
#!date = 2026-10-19
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = Bilibili,界面优化,去广告
#!type = normal

# 本插件不复制、不加载、不修改 Biliverse 脚本；原订阅保持启用。
# 正文复写会使同一响应的 Response Script 不执行；调整顺序不能使二者串联。
[Argument]
home_filter = switch,true,type=boolean,tag=接管首页广告与直播过滤,desc=开启后本插件处理首页推荐；关闭后交回原插件。不会执行原插件的首页补位与偏好设置。
story_filter = switch,true,type=boolean,tag=接管竖屏推广与界面优化,desc=开启后本插件处理竖屏及关联竖屏流；关闭后交回原插件。普通直播预览保留。
cart_filter = switch,true,type=boolean,tag=清理竖屏推广浮层,desc=清理推广卡片接口的anchor与ads；不按按钮文案拦截视频。

[Rewrite]
# 首页：必须同时移除广告与直播，避免只移除直播后广告重新出现。
response if ${home_filter} == true && ${url} ~= /^https:\/\/app\.(?:bilibili\.com|biliapi\.net|biliapi\.com)\/x\/v2\/feed\/index(?:\?|$)/ && ${response.status} == 200 then response.json.jq("def explicit_ad: if type != \"object\" then false else ((.card_type | type) == \"string\" and (.card_type | startswith(\"cm_\"))) or ((.card_goto | type) == \"string\" and (.card_goto | startswith(\"ad_\"))) or .goto == \"ad\" or .is_ad == true or .is_ad == 1 or (if (.ad_info | type) == \"object\" then .ad_info.is_ad == true or .ad_info.is_ad == 1 else false end) end; def home_live: if type != \"object\" then false elif .goto == \"live\" or .card_goto == \"live\" or .card_goto == \"ad_live_v2\" then true elif (.player_args | type) == \"object\" then .player_args.type == \"live\" or .player_args.is_live == true or .player_args.is_live == 1 else false end; def home_game_ad: if type == \"object\" then .card_type == \"small_cover_v10\" and .card_goto == \"game\" else false end; def clean_banner: if type != \"object\" then . elif .card_type != \"banner_v8\" or .card_goto != \"banner\" then . elif (.banner_item | type) != \"array\" or (.banner_item | length) == 0 then . else .banner_item |= map(select(if type == \"object\" then .type != \"ad\" and .type != \"ad_inline\" else true end)) | select((.banner_item | length) > 0) end; if type != \"object\" then . elif .code != 0 or (.data | type) != \"object\" then . elif (.data.items | type) != \"array\" then . else .data.items |= map(select((explicit_ad or home_live or home_game_ad) | not) | clean_banner) end")

# Story 与关联 Story：删除推广条目，保留普通视频及普通直播预览。
response if ${story_filter} == true && ${url} ~= /^https:\/\/app\.(?:bilibili\.com|biliapi\.net|biliapi\.com)\/x\/v2\/feed\/index\/(?:relate\/)?story(?:\?|$)/ && ${response.status} == 200 then response.json.jq("def explicit_ad: if type != \"object\" then false else ((.card_type | type) == \"string\" and (.card_type | startswith(\"cm_\"))) or ((.card_goto | type) == \"string\" and (.card_goto | startswith(\"ad_\"))) or .goto == \"ad\" or .is_ad == true or .is_ad == 1 or (if (.ad_info | type) == \"object\" then .ad_info.is_ad == true or .ad_info.is_ad == 1 else false end) end; def story_ad_route: if type != \"object\" then false else .goto as $g | .card_goto as $c | any([\"vertical_ad_av\", \"vertical_ad_picture\", \"vertical_ad_live\"][]; . == $g or . == $c) end; if type != \"object\" then . elif .code != 0 or (.data | type) != \"object\" then . else (if (.data.items | type) == \"array\" then .data.items |= map(select((explicit_ad or story_ad_route) | not) | if type == \"object\" then del(.scroll_guide) else . end) else . end) | (if (.data.config | type) == \"object\" then if (.data.config.live_auto_enter | type) == \"object\" then if (.data.config.live_auto_enter | has(\"enable\")) then .data.config.live_auto_enter.enable = false else . end else . end else . end) end")

# 浮层卡片没有可靠视频身份，仅清理浮层，不根据它猜测删除另一个接口的视频。
response if ${cart_filter} == true && ${url} ~= /^https:\/\/app\.(?:bilibili\.com|biliapi\.net|biliapi\.com)\/x\/v2\/feed\/index\/story\/cart(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code != 0 or (.data | type) != \"object\" then . else .data |= ( del(.anchor) | if (.ads | type) == \"array\" then .ads = [] else . end ) end")

[Mitm]
hostname = app.bilibili.com, app.biliapi.net, app.biliapi.com
