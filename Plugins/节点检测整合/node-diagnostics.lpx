#!select = MapNotification,false,true

[Script]
generic then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/loon/ipquality/ipquality.js") with tag="节点 IP 质量检测", img_url="shield.lefthalf.filled.system", timeout=50, enable=true
generic then script("https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/%E8%8A%82%E7%82%B9%E6%A3%80%E6%B5%8B%E6%95%B4%E5%90%88/node-diagnostics.js", "mode=entry") with tag="入口落地查询", img_url="globe.asia.australia.system", timeout=60, enable=true
generic then script("https://raw.githubusercontent.com/LuxJon/Loon-Rules/main/Plugins/%E8%8A%82%E7%82%B9%E6%A3%80%E6%B5%8B%E6%95%B4%E5%90%88/node-diagnostics.js", "mode=geo") with tag="地理位置查询", img_url="location.circle.system", timeout=30, enable=true
